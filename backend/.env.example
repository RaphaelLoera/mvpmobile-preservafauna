PORT=3333
# Use the Supabase connection string from Project Settings > Database.
# Prefer the Session pooler for local development.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
# Use false apenas quando a cadeia de certificados local não for confiável.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional direct connection used by Prisma migrations.
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[DB-HOST]:5432/postgres?sslmode=require
JWT_SECRET=troque-esta-chave
CORS_ORIGIN=http://localhost:5175
